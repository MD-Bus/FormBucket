{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "formbucket",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"observability": { "enabled": true },
	// No database_name / database_id on purpose. On deploy Wrangler creates a database named
	// "<worker-name>-db" and keeps reusing it. Worker names are unique per account, so two installs never
	// share a database. Setting a fixed database_name would make every install bind to any existing
	// database with that name. The tables are created and upgraded by the Worker itself on first request.
	"d1_databases": [
		{
			"binding": "DB",
			"migrations_dir": "migrations"
		}
	],
	// Retries failed webhook deliveries and prunes old analytics events.
	"triggers": { "crons": ["* * * * *"] }
}
