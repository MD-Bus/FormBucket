---
// Replaces Starlight's header social icons: a GitHub link that also shows the star count.
const repo = "momardia54/formbucket"
---

<a class="gh-link" href={`https://github.com/${repo}`} data-repo={repo} aria-label="FormBucket on GitHub">
  <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
  </svg>
  <span class="gh-stars" hidden>
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor">
      <path d="M8 .25a.75.75 0 0 1 .67.41l1.94 3.93 4.34.63a.75.75 0 0 1 .42 1.28l-3.14 3.06.74 4.32a.75.75 0 0 1-1.09.79L8 12.63l-3.88 2.04a.75.75 0 0 1-1.09-.79l.74-4.32L .63 6.5a.75.75 0 0 1 .42-1.28l4.34-.63L7.33.66A.75.75 0 0 1 8 .25Z"/>
    </svg>
    <span class="gh-count"></span>
  </span>
</a>

<script>
  // Star count from the public GitHub API, cached for an hour so pages don't hit the rate limit.
  // If the request fails (or the repo is private), the count stays hidden and the link still works.
  const link = document.querySelector<HTMLAnchorElement>(".gh-link")
  const box = link?.querySelector<HTMLElement>(".gh-stars")
  const out = link?.querySelector<HTMLElement>(".gh-count")
  const repo = link?.dataset.repo
  const key = `gh-stars:${repo}`

  const format = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1).replace(/\.0$/, "")}k` : String(n))
  const show = (n: number) => {
    if (!box || !out) return
    out.textContent = format(n)
    link!.title = `${n.toLocaleString()} stars on GitHub`
    box.hidden = false
  }

  async function load() {
    try {
      const cached = JSON.parse(localStorage.getItem(key) || "null")
      if (cached && Date.now() - cached.at < 3600_000) return show(cached.n)
    } catch {}
    try {
      const res = await fetch(`https://api.github.com/repos/${repo}`, { headers: { Accept: "application/vnd.github+json" } })
      if (!res.ok) return
      const n = (await res.json()).stargazers_count
      if (typeof n !== "number") return
      show(n)
      try {
        localStorage.setItem(key, JSON.stringify({ n, at: Date.now() }))
      } catch {}
    } catch {}
  }
  load()
</script>

<style>
  .gh-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
  }
  .gh-link:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  .gh-stars {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1;
  }
  .gh-stars[hidden] {
    display: none;
  }
</style>
